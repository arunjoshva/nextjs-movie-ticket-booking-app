// use prisma-8

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String   
  createdAt TimestamptzString @default(now())

  bookings  Booking[]
  
  @@map("users")
}

model Booking {
  id          Int  @id @default(autoincrement())
  userId      Int
  movieId     String
  movieTitle  String
  showKey     String
  showDate    String
  showTime    String
  totalAmount Int
  status      String  @default("CONFIRMED")
  createdAt   TimestamptzString @default(now())

  user        User  @relation(fields: [userId], references: [id])
  seats       BookingSeat[]

  @@index([userId])
  @@index([showKey])
  @@map("bookings")
}

model BookingSeat {
  id          Int @id @default(autoincrement())
  bookingId   Int
  showKey     String
  seatNumber  String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([showKey, seatNumber])
  @@index([bookingId])
  @@map("booking_seats")
}
